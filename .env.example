# Web service. All paths are relative to the project root.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=3000
MEDIA_DATA_DIR=data/service
MEDIA_UPLOAD_LIMIT_MB=64
MEDIA_RUB_PER_CREDIT=0.51
# Set only behind your own private access/TLS layer when exposing the service.
MEDIA_PUBLIC_ORIGIN=
# Server-owned key; no key entry or Kie account login in the web UI.
KIE_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# true: all private chats; false: only TELEGRAM_ALLOWED_USER_IDS (empty list denies everyone).
TELEGRAM_PUBLIC_ACCESS=true
# Operator IDs; also the access list when public access is false.
TELEGRAM_ALLOWED_USER_IDS=
