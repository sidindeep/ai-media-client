# Web service. All paths are relative to the project root.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=3000
# single (default), executor (the only background owner), or web (read/SSE replica).
# Web replicas forward all mutations to the executor over a private network.
MEDIA_REPLICA_ROLE=single
MEDIA_EXECUTOR_URL=
MEDIA_EXECUTOR_PUBLIC_ORIGIN=
# Docker DNS for external PostgreSQL and providers; override for your network.
MEDIA_DNS_PRIMARY=1.1.1.1
MEDIA_DNS_SECONDARY=8.8.8.8
MEDIA_DATA_DIR=data/service
# Compose reads these values from project .env; set an empty URL to disable.
# Only event names, source, error codes, and lifecycle markers are forwarded.
AI_LOGGER_SERVER_URL=https://ailogger.bothost.tech/ingest
AI_LOGGER_SERVICE=
AI_LOGGER_ENVIRONMENT=local
# Enable only for an explicitly selected private LAN HTTP logger.
AI_LOGGER_ALLOW_PRIVATE_HTTP=0
MEDIA_UPLOAD_LIMIT_MB=64
MEDIA_RUB_PER_CREDIT=0.51
# Canonical HTTPS origin, also used to construct OAuth callbacks.
MEDIA_PUBLIC_ORIGIN=
MEDIA_WEB_PUBLIC_ORIGIN=
MEDIA_AUTH_ENABLED=true
# PostgreSQL URL with host and database name is required when MEDIA_AUTH_ENABLED=true.
# Keep credentials on the server; missing or malformed URL prevents startup.
DATABASE_URL=
DATABASE_MIGRATION_URL=
MEDIA_RUNTIME_ROLE=
# Set false after a separate migration run and a switch to a DML-only runtime role.
MEDIA_DB_MIGRATE=true
DATABASE_SSL=0
# Maximum PostgreSQL connections per media process; budget across all replicas.
MEDIA_DB_POOL_MAX=15
MEDIA_SSE_MAX_CONNECTIONS=100
MEDIA_SSE_MAX_PER_ACCOUNT=8
MEDIA_UPLOAD_INFLIGHT_MB=256
MEDIA_CONTENT_STAGING_MB=1024
# Stop the embedded Kie login browser after this many idle minutes (1-60).
MEDIA_KIE_BROWSER_IDLE_MINUTES=5
# Shared private object storage. Use the same values on localhost and the debug host.
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=https://s3.twcstorage.ru
MEDIA_S3_BUCKET=ai-media-client
MEDIA_S3_REGION=ru-1
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Telegram Login Widget credentials from @BotFather (separate from TELEGRAM_BOT_TOKEN).
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
MEDIA_EMAIL_AUTH_ENABLED=false
MEDIA_SMTP_HOST=
MEDIA_SMTP_PORT=587
MEDIA_SMTP_USER=
MEDIA_SMTP_PASSWORD=
MEDIA_SMTP_FROM=
# Optional MAX partner bot with a mini-app URL set to https://your-domain/auth/max/confirm.
# Leave both values empty to disable MAX login; placeholder tokens are rejected.
MAX_LOGIN_BOT_NAME=
MAX_LOGIN_BOT_TOKEN=
# Exact immutable provider IDs, comma separated, e.g. google:subject,vk:subject.
# Never assign admin to the first registration or by an unverified email.
MEDIA_ADMIN_IDENTITIES=
MEDIA_SESSION_SECONDS=604800
MEDIA_PRICING_FILE=config/native-prices.json
# Paid offers and payment provider. For a local no-charge checkout preview, set both flags true and use MEDIA_PAYMENTS_PROVIDER=yookassa-stub with test environment. A real merchant requires a separate setup.
MEDIA_PRODUCT_OFFERS_FILE=config/product-offers.json
MEDIA_SALES_ENABLED=false
MEDIA_PAYMENTS_ENABLED=false
MEDIA_PAYMENTS_ENVIRONMENT=test
MEDIA_PAYMENTS_CLIENT_ID=ai-media-client
MEDIA_PAYMENTS_PROVIDER=yookassa-stub
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Private Codex worker URL for a non-Compose web process. Compose sets it itself.
MEDIA_CODEX_URL=
# Worker transport: app-server (default) or exec (manual fallback). Applies to embedded and sidecar.
MEDIA_CODEX_TRANSPORT=app-server
MEDIA_CODEX_POOL_SIZE=2
MEDIA_CODEX_PROCESS_CONCURRENCY=128
MEDIA_CODEX_RPC_TIMEOUT_MS=60000
# Root Dockerfile enables a private in-process worker for single-container hosts.
# Leave this unset on Bothost; Compose explicitly disables it for its sidecar.
# Existing persistent Docker volume with server Codex login.
MEDIA_CODEX_AUTH_VOLUME=ai-media-codex-auth
# Server-owned key; no key entry or Kie account login in the web UI.
KIE_API_KEY=
KIE_API_KEY_2=
ROUTERAI_API_KEY=
APIMART_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# true: all private chats; false: only TELEGRAM_ALLOWED_USER_IDS (empty list denies everyone).
TELEGRAM_PUBLIC_ACCESS=true
# Operator IDs; also the access list when public access is false.
TELEGRAM_ALLOWED_USER_IDS=
# Optional server-side Google Drive API key for public movie folders/files.
MEDIA_GOOGLE_DRIVE_API_KEY=
