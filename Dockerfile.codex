FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.155.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force

ENV NODE_ENV=production CODEX_HOME=/home/node/.codex
WORKDIR /worker
RUN mkdir -p /home/node/.codex /worker/results \
    && chown node:node /home/node/.codex /worker/results
COPY --chown=node:node src/services/codex-request.js src/services/codex-worker.js ./src/services/
COPY --chown=node:node src/services/codex-images.js src/services/codex-login.js ./src/services/
COPY --chown=node:node src/services/codex-usage.js ./src/services/
COPY --chown=node:node src/services/codex-errors.js ./src/services/
COPY --chown=node:node src/generation-log.js ./src/
COPY --chown=node:node src/ai-logger ./src/ai-logger/
COPY --chown=node:node src/provider-diagnostics.js ./src/
COPY --chown=node:node src/services/codex-exec.js src/services/codex-app-server.js src/services/codex-runtime.js ./src/services/
COPY --chown=node:node src/services/codex-app-server-pool.js ./src/services/
COPY --chown=node:node config/codex-models.json ./config/
USER node
ENTRYPOINT ["node", "/worker/src/services/codex-worker.js"]
