# Web service. All paths are relative to the project root.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=3000
# Docker DNS for external PostgreSQL and providers; override for your network.
MEDIA_DNS_PRIMARY=1.1.1.1
MEDIA_DNS_SECONDARY=8.8.8.8
MEDIA_DATA_DIR=data/service
MEDIA_UPLOAD_LIMIT_MB=64
MEDIA_RUB_PER_CREDIT=0.51
# Canonical HTTPS origin, also used to construct OAuth callbacks.
MEDIA_PUBLIC_ORIGIN=
MEDIA_AUTH_ENABLED=true
# PostgreSQL, same pg.Pool connection pattern as Benz AI. Never expose this URL to clients.
DATABASE_URL=
DATABASE_SSL=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
# Exact immutable provider IDs, comma separated, e.g. google:subject,vk:subject.
# Never assign admin to the first registration or by an unverified email.
MEDIA_ADMIN_IDENTITIES=
MEDIA_SESSION_SECONDS=604800
MEDIA_PRICING_FILE=config/native-prices.json
# Private Codex worker URL for a non-Compose web process. Compose sets it itself.
MEDIA_CODEX_URL=
# Worker transport: app-server (default) or exec (manual fallback). Applies to embedded and sidecar.
MEDIA_CODEX_TRANSPORT=app-server
MEDIA_CODEX_POOL_SIZE=2
MEDIA_CODEX_PROCESS_CONCURRENCY=128
MEDIA_CODEX_RPC_TIMEOUT_MS=60000
# Root Dockerfile enables a private in-process worker for single-container hosts.
# Leave this unset on Bothost; Compose explicitly disables it for its sidecar.
# Existing persistent Docker volume with server Codex login.
MEDIA_CODEX_AUTH_VOLUME=llm-providers_codex-auth
# Server-owned key; no key entry or Kie account login in the web UI.
KIE_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# true: all private chats; false: only TELEGRAM_ALLOWED_USER_IDS (empty list denies everyone).
TELEGRAM_PUBLIC_ACCESS=true
# Operator IDs; also the access list when public access is false.
TELEGRAM_ALLOWED_USER_IDS=
GCORE_CDN_TOKEN=
